BUILD_VERSION=$(curl -s -I https://cdn.amazonlinux.com/al2023/os-images/latest/ |grep -i location: |sed -e 's/.*os-images\///' -e 's/\///')
BUILD_DISTRO=AL$BUILD_VERSION
BUILD_ARCH="arm64"
BUILD_URL="https://cdn.amazonlinux.com/al2023/os-images/$BUILD_VERSION/container-arm64/al2023-container-$BUILD_VERSION-$BUILD_ARCH.tar.xz"
